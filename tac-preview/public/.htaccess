# TLC site — Hostinger / Apache configuration
# ===========================================
# Bundled into the production build (Vite copies /public to /dist) so a
# fresh upload + extract always lands with the rewrite rules in place.
# No manual setup on the server needed.

# ── SPA routing — React Router owns all unknown paths ───────────────────
# Without this, /blog, /about-us, /skin-aesthetics and the rest return
# 404/403 because Apache looks for matching files/folders on disk.
#
# IMPORTANT: We only skip the rewrite for REAL FILES (`!-f`), not folders.
# The build output contains real folders that collide with React routes:
#   • dist/skin-aesthetics/  (service image assets) vs route /skin-aesthetics
#   • dist/diagnostics/      (icon assets)         vs route /diagnostics
#   • dist/blog/             (per-blog hero imgs)  vs route /blog
# If we add `!-d`, Apache tries to directory-list these folders, finds no
# index.html inside, and returns 403 Forbidden. Files inside the folder
# (e.g. /skin-aesthetics/01-prp-acp.jpg) are still real files, so `!-f`
# alone correctly leaves them untouched and they serve directly.
#
# DirectorySlash off prevents mod_dir from 301-redirecting /foo to /foo/
# when /foo is a directory — without this the SPA URL bounces through a
# slash redirect before our rewrite catches it.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If the request points at a real file (.js, .css, .jpg, .xml, etc.),
  # let Apache serve it normally.
  RewriteCond %{REQUEST_FILENAME} !-f

  # Don't accidentally rewrite the index file itself into a loop.
  RewriteRule !^index\.html$ index.html [L]
</IfModule>

# ── Force HTTPS ─────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ── Caching — long for hashed assets, no-cache for HTML ─────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # Vite hashes /assets/* filenames, so they can be cached forever
  <FilesMatch "\.(js|css|woff|woff2|ttf|eot)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images — cache 1 year too (filenames carry ?v= query when bumped)
  <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp|avif|ico)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # Videos — cache 1 month (rarely change but heavier to redownload)
  <FilesMatch "\.(mp4|webm|mov)$">
    ExpiresDefault "access plus 1 month"
  </FilesMatch>

  # HTML — never cache, always fetch fresh so deploys take effect instantly
  <FilesMatch "\.(html|xml|json|webmanifest)$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compression — serve gzip when the browser supports it ───────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf application/font-woff
</IfModule>

# ── Security headers ────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Disable directory listing ───────────────────────────────────────────
Options -Indexes

# ── Default character encoding ──────────────────────────────────────────
AddDefaultCharset UTF-8
